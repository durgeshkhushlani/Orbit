OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=orbit_documents

# Comma-separated list of root directories the File Agent is allowed to touch.
ORBIT_ALLOWED_DIRS=

# SMTP credentials for the Email Agent (e.g. an app password for Gmail/Outlook).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Your own address, so requests like "email it to myself" resolve correctly.
ORBIT_USER_EMAIL=
